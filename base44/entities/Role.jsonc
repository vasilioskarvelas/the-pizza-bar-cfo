{
  "name": "Role",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "role_key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "platform",
        "organisation",
        "site"
      ],
      "default": "organisation"
    },
    "is_system": {
      "type": "boolean",
      "default": false
    },
    "parent_role_id": {
      "type": "string"
    },
    "level": {
      "type": "number",
      "default": 0
    },
    "permissions_summary": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "retired"
      ],
      "default": "active"
    }
  },
  "required": [
    "organisation_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}