{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "system_role": {
      "type": "string",
      "enum": [
        "owner",
        "finance_manager",
        "site_manager",
        "shift_supervisor",
        "accountant",
        "auditor",
        "system"
      ]
    },
    "mfa_enrolled": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "offboarded"
      ],
      "default": "active"
    },
    "offboarded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organisation_id",
    "user_id"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.user_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.user_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}