{
  "name": "ScoreMethodologyInput",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "component_id": {
      "type": "string"
    },
    "kpi_definition_id": {
      "type": "string"
    },
    "input_key": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "organisation_id",
    "component_id",
    "input_key"
  ],
  "rls": {
    "read": {
      "data.organisation_id": "{{user.data.organisation_id}}"
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}