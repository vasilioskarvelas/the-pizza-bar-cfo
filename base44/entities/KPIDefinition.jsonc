{
  "name": "KPIDefinition",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "formula_description": {
      "type": "string"
    },
    "unit": {
      "type": "string",
      "enum": [
        "percentage",
        "currency",
        "weeks",
        "days",
        "count",
        "ratio"
      ]
    },
    "direction": {
      "type": "string",
      "enum": [
        "lower_is_better",
        "higher_is_better"
      ]
    },
    "evaluation_cadence": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "quarterly"
      ]
    },
    "owner_role": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "retired"
      ],
      "default": "active"
    }
  },
  "required": [
    "organisation_id",
    "code",
    "name"
  ],
  "rls": {
    "read": {
      "data.organisation_id": "{{user.data.organisation_id}}"
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}