{
  "name": "DataFreshnessRule",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "source_system": {
      "type": "string"
    },
    "expected_frequency_hours": {
      "type": "number"
    },
    "max_staleness_hours": {
      "type": "number"
    },
    "alert_severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "organisation_id",
    "source_system",
    "max_staleness_hours",
    "effective_from"
  ],
  "rls": {
    "read": {
      "data.organisation_id": "{{user.data.organisation_id}}"
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}