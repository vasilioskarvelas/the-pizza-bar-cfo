{
  "name": "ImportError",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "import_batch_id": {
      "type": "string"
    },
    "source_record_id": {
      "type": "string"
    },
    "external_record_id": {
      "type": "string"
    },
    "external_entity_type": {
      "type": "string"
    },
    "error_stage": {
      "type": "string",
      "enum": [
        "fetch",
        "parse",
        "validate",
        "persist",
        "duplicate"
      ]
    },
    "error_code": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "warning",
        "critical"
      ],
      "default": "warning"
    },
    "raw_payload": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organisation_id",
    "import_batch_id",
    "error_stage"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.site_id": null
            },
            {
              "data.site_id": {
                "$in": "{{user.data.site_ids}}"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}