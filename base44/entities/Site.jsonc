{
  "name": "Site",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "suburb": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "abn": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "default": "Australia/Melbourne"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed",
        "opening"
      ],
      "default": "active"
    },
    "opening_date": {
      "type": "string",
      "format": "date"
    },
    "floor_area_sqm": {
      "type": "number"
    }
  },
  "required": [
    "name",
    "suburb"
  ]
}