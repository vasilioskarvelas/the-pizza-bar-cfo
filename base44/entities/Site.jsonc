{
  "name": "Site",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "suburb": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "postcode": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "default": "AU"
    },
    "abn": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "manager_user_ids": {
      "type": "string"
    },
    "cost_centre_id": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "default": "Australia/Melbourne"
    },
    "trading_hours": {
      "type": "string"
    },
    "default_reporting_rules": {
      "type": "string"
    },
    "business_day_boundary": {
      "type": "string",
      "default": "04:00"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed",
        "opening"
      ],
      "default": "active"
    },
    "opening_date": {
      "type": "string",
      "format": "date"
    },
    "floor_area_sqm": {
      "type": "number"
    },
    "trading_days_per_week": {
      "type": "number",
      "default": 7
    }
  },
  "required": [
    "organisation_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "id": {
                    "$in": "{{user.data.site_ids}}"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}