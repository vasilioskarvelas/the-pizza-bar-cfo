{
  "name": "SalesTransaction",
  "type": "object",
  "properties": {
    "site_id": {
      "type": "string"
    },
    "site_name": {
      "type": "string"
    },
    "business_date": {
      "type": "string",
      "format": "date"
    },
    "gross_sales": {
      "type": "number"
    },
    "discounts": {
      "type": "number",
      "default": 0
    },
    "refunds": {
      "type": "number",
      "default": 0
    },
    "net_sales_gst_incl": {
      "type": "number"
    },
    "gst": {
      "type": "number"
    },
    "net_sales": {
      "type": "number"
    },
    "transaction_count": {
      "type": "number"
    },
    "cover_count": {
      "type": "number"
    },
    "dine_in_sales": {
      "type": "number",
      "default": 0
    },
    "takeaway_sales": {
      "type": "number",
      "default": 0
    },
    "delivery_sales": {
      "type": "number",
      "default": 0
    },
    "channel": {
      "type": "string",
      "enum": [
        "dine_in",
        "takeaway",
        "delivery",
        "online"
      ],
      "default": "dine_in"
    }
  },
  "required": [
    "site_id",
    "business_date",
    "net_sales"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": false,
    "update": false,
    "delete": false
  }
}