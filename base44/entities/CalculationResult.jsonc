{
  "name": "CalculationResult",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "calculation_run_id": {
      "type": "string"
    },
    "result_type": {
      "type": "string",
      "enum": [
        "kpi",
        "score_component",
        "financial_figure"
      ]
    },
    "kpi_definition_id": {
      "type": "string"
    },
    "methodology_component_id": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "confirmed",
        "estimated",
        "forecast"
      ],
      "default": "estimated"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "supersedes_result_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    }
  },
  "required": [
    "organisation_id",
    "calculation_run_id",
    "result_type",
    "entity_type",
    "entity_id",
    "value"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.site_id": null
            },
            {
              "data.site_id": {
                "$in": "{{user.data.site_ids}}"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}