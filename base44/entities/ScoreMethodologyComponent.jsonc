{
  "name": "ScoreMethodologyComponent",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "methodology_version_id": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "weight": {
      "type": "number"
    },
    "component_type": {
      "type": "string"
    },
    "sort_order": {
      "type": "number"
    }
  },
  "required": [
    "organisation_id",
    "methodology_version_id",
    "code",
    "name",
    "weight"
  ],
  "rls": {
    "read": {
      "data.organisation_id": "{{user.data.organisation_id}}"
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}