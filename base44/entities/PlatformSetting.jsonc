{
  "name": "PlatformSetting",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "setting_key": {
      "type": "string"
    },
    "setting_value": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "default": "general"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "setting_key"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}