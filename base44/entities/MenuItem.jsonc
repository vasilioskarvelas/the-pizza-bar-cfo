{
  "name": "MenuItem",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "selling_price_cents": {
      "type": "number",
      "default": 0
    },
    "ingredient_cost_cents": {
      "type": "number",
      "default": 0
    },
    "packaging_cost_cents": {
      "type": "number",
      "default": 0
    },
    "platform_commission_cents": {
      "type": "number",
      "default": 0
    },
    "labour_allocation_cents": {
      "type": "number",
      "default": 0
    },
    "sales_quantity": {
      "type": "number",
      "default": 0
    },
    "contribution_margin_cents": {
      "type": "number",
      "default": 0
    },
    "profitability_rating": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "default": "B"
    },
    "ingredient_cost_change_pct": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "organisation_id",
    "business_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}