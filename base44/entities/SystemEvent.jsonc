{
  "name": "SystemEvent",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ingestion_heartbeat",
        "sync_completed",
        "cache_synced",
        "job_ran",
        "connector_run_started",
        "connector_run_completed",
        "calculation_run_completed",
        "reconciliation_run_completed",
        "system_error",
        "config_changed"
      ]
    },
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "default": "info"
    },
    "message": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "actor_user_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organisation_id",
    "event_type",
    "message"
  ],
  "rls": {
    "read": {
      "data.organisation_id": "{{user.data.organisation_id}}"
    },
    "create": false,
    "update": false,
    "delete": false
  }
}