{
  "name": "PlatformFee",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "platform_settlement_id": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "uber_eats",
        "doordash",
        "menulog",
        "other"
      ]
    },
    "fee_type": {
      "type": "string",
      "enum": [
        "commission",
        "service_fee",
        "promotion",
        "refund_adjustment",
        "other_adjustment",
        "gst_adjustment"
      ]
    },
    "amount_cents": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string"
    },
    "business_date": {
      "type": "string",
      "format": "date"
    },
    "week_start": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "organisation_id",
    "platform_settlement_id",
    "platform",
    "fee_type",
    "amount_cents"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.site_id": null
            },
            {
              "data.site_id": {
                "$in": "{{user.data.site_ids}}"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}