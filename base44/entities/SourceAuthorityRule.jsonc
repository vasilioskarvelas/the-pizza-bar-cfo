{
  "name": "SourceAuthorityRule",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "authoritative_source": {
      "type": "string"
    },
    "secondary_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflict_resolution": {
      "type": "string",
      "enum": [
        "authoritative_wins",
        "flag_exception",
        "latest_wins"
      ]
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "effective_to": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "organisation_id",
    "entity_type",
    "authoritative_source",
    "effective_from"
  ],
  "rls": {
    "read": {
      "data.organisation_id": "{{user.data.organisation_id}}"
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}