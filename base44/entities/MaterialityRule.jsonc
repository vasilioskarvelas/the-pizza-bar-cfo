{
  "name": "MaterialityRule",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "metric": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "threshold_absolute": {
      "type": "number"
    },
    "threshold_percentage": {
      "type": "number"
    },
    "suppression_window_hours": {
      "type": "number"
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "effective_to": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "organisation_id",
    "metric",
    "threshold_absolute",
    "effective_from"
  ],
  "rls": {
    "read": {
      "data.organisation_id": "{{user.data.organisation_id}}"
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}