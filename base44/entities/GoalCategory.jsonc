{
  "name": "GoalCategory",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "category_key": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "default_direction": {
      "type": "string",
      "enum": [
        "maximize",
        "minimize"
      ],
      "default": "maximize"
    },
    "default_unit": {
      "type": "string",
      "default": "cents"
    },
    "linked_kpi_code": {
      "type": "string"
    },
    "linked_figure_code": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "organisation_id",
    "category_key",
    "label"
  ],
  "rls": {
    "read": {
      "data.organisation_id": "{{user.data.organisation_id}}"
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}