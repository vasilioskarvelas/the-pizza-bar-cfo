{
  "name": "ExecutiveDecision",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "decision_date": {
      "type": "string",
      "format": "date"
    },
    "owner_user_id": {
      "type": "string"
    },
    "expected_outcome": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "forecast_ref": {
      "type": "string"
    },
    "actual_outcome": {
      "type": "string"
    },
    "actual_value": {
      "type": "number"
    },
    "expected_value": {
      "type": "number"
    },
    "variance": {
      "type": "number"
    },
    "variance_pct": {
      "type": "number"
    },
    "lessons_learned": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "implemented",
        "reviewed",
        "abandoned"
      ],
      "default": "pending"
    },
    "review_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "organisation_id",
    "decision",
    "decision_date"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.site_id": null
            },
            {
              "data.site_id": {
                "$in": "{{user.data.site_ids}}"
              }
            },
            {
              "data.owner_user_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.owner_user_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.owner_user_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}