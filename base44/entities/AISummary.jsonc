{
  "name": "AISummary",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "summary_key": {
      "type": "string"
    },
    "context_hash": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "organisation",
        "site"
      ],
      "default": "organisation"
    },
    "model": {
      "type": "string"
    },
    "prompt_context": {
      "type": "string"
    },
    "payload": {
      "type": "string"
    },
    "headline": {
      "type": "string"
    },
    "outlook": {
      "type": "string",
      "enum": [
        "strong",
        "stable",
        "cautious",
        "at_risk",
        "critical"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "skipped",
        "fallback"
      ],
      "default": "passed"
    },
    "validation_mismatches": {
      "type": "string"
    },
    "used_fallback": {
      "type": "boolean",
      "default": false
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "owner_score": {
      "type": "number"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "engine_version": {
      "type": "string"
    }
  },
  "required": [
    "organisation_id",
    "summary_key"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.site_id": null
            },
            {
              "data.site_id": {
                "$in": "{{user.data.site_ids}}"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}