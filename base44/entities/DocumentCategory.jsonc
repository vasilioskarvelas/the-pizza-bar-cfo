{
  "name": "DocumentCategory",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "category_key": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "retention_days": {
      "type": "number",
      "default": 2555
    },
    "description": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "organisation_id",
    "category_key",
    "label"
  ],
  "rls": {
    "read": {
      "data.organisation_id": "{{user.data.organisation_id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}