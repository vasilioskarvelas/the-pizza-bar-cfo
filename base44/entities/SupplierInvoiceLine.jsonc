{
  "name": "SupplierInvoiceLine",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "supplier": {
      "type": "string"
    },
    "product": {
      "type": "string"
    },
    "unit_cost_cents": {
      "type": "number",
      "default": 0
    },
    "quantity": {
      "type": "number",
      "default": 0
    },
    "invoice_date": {
      "type": "string",
      "format": "date"
    },
    "invoice_ref": {
      "type": "string"
    },
    "category": {
      "type": "string"
    }
  },
  "required": [
    "organisation_id",
    "business_id",
    "supplier",
    "product",
    "invoice_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}