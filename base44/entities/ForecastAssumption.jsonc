{
  "name": "ForecastAssumption",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "metric_code": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "growth_bps": {
      "type": "number",
      "default": 0
    },
    "method": {
      "type": "string",
      "enum": [
        "auto",
        "trend",
        "flat",
        "assumption"
      ],
      "default": "auto"
    },
    "notes": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "organisation_id",
    "metric_code",
    "method"
  ],
  "rls": {
    "read": {
      "data.organisation_id": "{{user.data.organisation_id}}"
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}