{
  "name": "Anomaly",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "anomaly_type": {
      "type": "string",
      "enum": [
        "price_change",
        "margin_drift",
        "labour_variance",
        "cash_mismatch",
        "sales_anomaly",
        "compliance",
        "supplier",
        "void_spike"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "default": "warning"
    },
    "site_name": {
      "type": "string"
    },
    "detected_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "acknowledged",
        "resolved",
        "dismissed"
      ],
      "default": "open"
    },
    "impact_amount": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "anomaly_type",
    "severity",
    "detected_date"
  ]
}