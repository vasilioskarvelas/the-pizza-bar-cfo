{
  "name": "KPIThresholdVersion",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "kpi_definition_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "target": {
      "type": "number"
    },
    "warning": {
      "type": "number"
    },
    "critical": {
      "type": "number"
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "effective_to": {
      "type": "string",
      "format": "date"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "rationale": {
      "type": "string"
    }
  },
  "required": [
    "organisation_id",
    "kpi_definition_id",
    "target",
    "effective_from"
  ],
  "rls": {
    "read": {
      "data.organisation_id": "{{user.data.organisation_id}}"
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}