{
  "name": "ApproximationRegister",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "field_name": {
      "type": "string"
    },
    "approximation_method": {
      "type": "string"
    },
    "label_required": {
      "type": "boolean",
      "default": true
    },
    "data_quality_source": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "organisation_id",
    "entity_type",
    "field_name"
  ],
  "rls": {
    "read": {
      "data.organisation_id": "{{user.data.organisation_id}}"
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}