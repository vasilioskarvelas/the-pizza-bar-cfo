{
  "name": "CommitmentSourceLink",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "commitment_id": {
      "type": "string"
    },
    "source_record_id": {
      "type": "string"
    },
    "link_type": {
      "type": "string",
      "enum": [
        "primary",
        "supporting",
        "evidence"
      ]
    },
    "site_id": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "site",
        "shared"
      ],
      "default": "site"
    }
  },
  "required": [
    "organisation_id",
    "commitment_id",
    "source_record_id"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.scope": "shared"
            },
            {
              "data.site_id": {
                "$in": "{{user.data.site_ids}}"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.site_id": {
                "$in": "{{user.data.site_ids}}"
              }
            }
          ]
        }
      ]
    },
    "update": false,
    "delete": false
  }
}