{
  "name": "Permission",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "organisation",
        "site",
        "system"
      ],
      "default": "organisation"
    }
  },
  "required": [
    "organisation_id",
    "code"
  ],
  "rls": {
    "read": {
      "data.organisation_id": "{{user.data.organisation_id}}"
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}