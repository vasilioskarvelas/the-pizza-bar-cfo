{
  "name": "Organisation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "legal_name": {
      "type": "string"
    },
    "trading_name": {
      "type": "string"
    },
    "abn": {
      "type": "string"
    },
    "parent_id": {
      "type": "string"
    },
    "organisation_type": {
      "type": "string",
      "enum": [
        "independent",
        "franchise_group",
        "franchisee",
        "subsidiary",
        "practice",
        "portfolio",
        "holding"
      ],
      "default": "independent"
    },
    "industry": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended"
      ],
      "default": "active"
    },
    "gst_method": {
      "type": "string",
      "enum": [
        "cash",
        "accrual"
      ],
      "default": "accrual"
    },
    "default_currency": {
      "type": "string",
      "default": "AUD"
    },
    "timezone": {
      "type": "string",
      "default": "Australia/Melbourne"
    },
    "financial_year_start_month": {
      "type": "number",
      "default": 7
    },
    "data_residency": {
      "type": "string",
      "default": "AU"
    },
    "logo_url": {
      "type": "string"
    },
    "branding": {
      "type": "string"
    },
    "tax_settings": {
      "type": "string"
    },
    "settings": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}