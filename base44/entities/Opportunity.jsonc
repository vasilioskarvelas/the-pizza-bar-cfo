{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "rule_key": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "financial_impact_cents": {
      "type": "number",
      "default": 0
    },
    "owner_score_impact": {
      "type": "number",
      "default": 0
    },
    "implementation_effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "affected_metric": {
      "type": "string"
    },
    "recommended_action": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "identified",
        "evaluating",
        "approved",
        "in_progress",
        "realised",
        "rejected"
      ],
      "default": "identified"
    },
    "owner_user_id": {
      "type": "string"
    },
    "goal_id": {
      "type": "string"
    },
    "target_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "organisation_id",
    "rule_key",
    "title"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.site_id": null
            },
            {
              "data.site_id": {
                "$in": "{{user.data.site_ids}}"
              }
            },
            {
              "data.owner_user_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.owner_user_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}