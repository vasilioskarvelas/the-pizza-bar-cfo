{
  "name": "AttentionItem",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "red",
        "orange",
        "green"
      ]
    },
    "category": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "issue": {
      "type": "string"
    },
    "financial_impact_cents": {
      "type": "number",
      "default": 0
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "reason": {
      "type": "string"
    },
    "recommended_action": {
      "type": "string"
    },
    "evidence_summary": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewed",
        "resolved"
      ],
      "default": "new"
    }
  },
  "required": [
    "organisation_id",
    "business_id",
    "severity",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}