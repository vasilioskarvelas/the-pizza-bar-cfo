{
  "name": "ReconciliationRun",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "reconciliation_type": {
      "type": "string"
    },
    "dataset_a": {
      "type": "string"
    },
    "dataset_b": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "methodology_version_id": {
      "type": "string"
    },
    "triggered_by": {
      "type": "string"
    },
    "run_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "completed_with_exceptions",
        "failed",
        "cancelled"
      ],
      "default": "running"
    },
    "total_checked": {
      "type": "number",
      "default": 0
    },
    "matched_count": {
      "type": "number",
      "default": 0
    },
    "exception_count": {
      "type": "number",
      "default": 0
    },
    "engine_version": {
      "type": "string"
    }
  },
  "required": [
    "organisation_id",
    "reconciliation_type",
    "dataset_a",
    "dataset_b",
    "entity_type",
    "period_start",
    "period_end"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.site_id": null
            },
            {
              "data.site_id": {
                "$in": "{{user.data.site_ids}}"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.site_id": {
                "$in": "{{user.data.site_ids}}"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.site_id": {
                "$in": "{{user.data.site_ids}}"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}