{
  "name": "OpportunityRule",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "rule_key": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "affected_metric": {
      "type": "string"
    },
    "threshold": {
      "type": "number"
    },
    "comparator": {
      "type": "string",
      "enum": [
        "lt",
        "lte",
        "gt",
        "gte",
        "eq"
      ],
      "default": "gt"
    },
    "impact_formula": {
      "type": "string"
    },
    "owner_score_impact": {
      "type": "number",
      "default": 0
    },
    "default_effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "recommended_action": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "organisation_id",
    "rule_key",
    "title"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}