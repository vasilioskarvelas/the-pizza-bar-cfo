{
  "name": "ReceivableInvoice",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "customer": {
      "type": "string"
    },
    "amount_cents": {
      "type": "number",
      "default": 0
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "paid",
        "overdue"
      ],
      "default": "open"
    },
    "invoice_ref": {
      "type": "string"
    }
  },
  "required": [
    "organisation_id",
    "business_id",
    "amount_cents",
    "due_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}