{
  "name": "TaxRate",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "tax_type": {
      "type": "string",
      "enum": [
        "GST",
        "PAYG_withholding",
        "PAYG_instalment",
        "super_guarantee",
        "payroll_tax",
        "company_tax",
        "FBT"
      ]
    },
    "label": {
      "type": "string"
    },
    "rate": {
      "type": "number"
    },
    "threshold": {
      "type": "number"
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "effective_to": {
      "type": "string",
      "format": "date"
    },
    "jurisdiction": {
      "type": "string",
      "default": "AU"
    }
  },
  "required": [
    "organisation_id",
    "tax_type",
    "effective_from"
  ],
  "rls": {
    "read": {
      "data.organisation_id": "{{user.data.organisation_id}}"
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}