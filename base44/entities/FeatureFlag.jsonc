{
  "name": "FeatureFlag",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "feature_key": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "rollout_percentage": {
      "type": "number",
      "default": 0
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "effective_to": {
      "type": "string",
      "format": "date"
    },
    "created_by": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "organisation_id",
    "feature_key",
    "enabled",
    "effective_from"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.site_id": null
            },
            {
              "data.site_id": {
                "$in": "{{user.data.site_ids}}"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}