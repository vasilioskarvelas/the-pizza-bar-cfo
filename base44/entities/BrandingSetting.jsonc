{
  "name": "BrandingSetting",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "primary_color": {
      "type": "string",
      "default": "#0f172a"
    },
    "accent_color": {
      "type": "string",
      "default": "#f59e0b"
    },
    "report_header": {
      "type": "string"
    },
    "email_footer": {
      "type": "string"
    },
    "login_bg_url": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "organisation_id"
  ],
  "rls": {
    "read": {
      "data.organisation_id": "{{user.data.organisation_id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}