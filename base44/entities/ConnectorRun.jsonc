{
  "name": "ConnectorRun",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "connector_id": {
      "type": "string"
    },
    "source_system": {
      "type": "string",
      "enum": [
        "pos",
        "xero",
        "payroll",
        "banking",
        "supplier_invoice",
        "rostering",
        "delivery",
        "manual"
      ]
    },
    "run_type": {
      "type": "string",
      "enum": [
        "scheduled",
        "manual",
        "webhook"
      ],
      "default": "manual"
    },
    "run_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "completed_with_errors",
        "failed",
        "cancelled"
      ],
      "default": "running"
    },
    "records_fetched": {
      "type": "number",
      "default": 0
    },
    "records_imported": {
      "type": "number",
      "default": 0
    },
    "records_failed": {
      "type": "number",
      "default": 0
    },
    "triggered_by": {
      "type": "string"
    },
    "engine_version": {
      "type": "string"
    },
    "error_summary": {
      "type": "string"
    }
  },
  "required": [
    "organisation_id",
    "connector_id",
    "source_system",
    "run_started_at"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.site_id": null
            },
            {
              "data.site_id": {
                "$in": "{{user.data.site_ids}}"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.site_id": {
                "$in": "{{user.data.site_ids}}"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.site_id": {
                "$in": "{{user.data.site_ids}}"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}