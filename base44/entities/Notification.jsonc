{
  "name": "Notification",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "notification_type": {
      "type": "string",
      "enum": [
        "alert",
        "task",
        "anomaly",
        "reminder",
        "system",
        "mention"
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "default": "info"
    },
    "status": {
      "type": "string",
      "enum": [
        "unread",
        "read",
        "dismissed",
        "archived"
      ],
      "default": "unread"
    },
    "related_entity_type": {
      "type": "string"
    },
    "related_entity_id": {
      "type": "string"
    },
    "action_url": {
      "type": "string"
    }
  },
  "required": [
    "organisation_id",
    "user_id",
    "title"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.user_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.user_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}