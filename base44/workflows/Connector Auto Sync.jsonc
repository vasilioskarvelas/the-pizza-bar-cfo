{
  "name": "Connector Auto Sync",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "connector_auto_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_all": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runConnectorSync",
            "args": {
              "trigger": "scheduled"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync all active connectors",
            "description": "Hourly immutable ingestion"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "Australia/Melbourne",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Hourly automatic sync of all active connectors (immutable raw ingestion). Invokes the runConnectorSync backend function."
}